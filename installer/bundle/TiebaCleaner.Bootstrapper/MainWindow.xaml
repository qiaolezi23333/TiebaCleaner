<Window x:Class="TiebaCleaner.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TiebaCleaner.Bootstrapper"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="贴吧清理助手安装程序"
        Width="960" Height="640" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Background="#080C18" Foreground="#F6F8FF"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9DA9C2" />
        <SolidColorBrush x:Key="Card" Color="#D0151D34" />
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F82FF" Offset="0" />
            <GradientStop Color="#7C68FF" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="Glow" Color="#4F82FF" BlurRadius="28" ShadowDepth="0" Opacity="0.34" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="144" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource Glow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="22,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.36" /><Setter Property="Effect" Value="{x:Null}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="#2FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ScopeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEF2FF" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Ellipse Width="16" Height="16" Stroke="#8293B7" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#6490FF" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Box" Property="Background" Value="#204F82FF" /><Setter TargetName="Box" Property="BorderBrush" Value="#755E8BFF" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8A7DA3FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE4F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#12FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1">
                                <TextBlock x:Name="Check" Text="✓" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#5C82FF" /><Setter TargetName="Box" Property="BorderBrush" Value="#7B9DFF" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#9DB7FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="520" Height="520" Fill="#22537CFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-240,-300,0,0"><Ellipse.Effect><BlurEffect Radius="86" /></Ellipse.Effect></Ellipse>
        <Ellipse Width="420" Height="420" Fill="#187C68FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-270"><Ellipse.Effect><BlurEffect Radius="92" /></Ellipse.Effect></Ellipse>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#080C18" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" Panel.ZIndex="5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <Viewbox Margin="5"><Path Data="M4,3 L16,3 C18,3 19,4 19,6 L19,16 C19,18 18,19 16,19 L4,19 C2,19 1,18 1,16 L1,6 C1,4 2,3 4,3 M6,8 L14,8 M6,12 L12,12" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox>
                    </Border>
                    <TextBlock Text="贴吧清理助手" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  安装程序" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Click="Minimize_OnClick" Background="Transparent" BorderThickness="0" Foreground="#AEB9D1" FontSize="20" Content="−" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="2" Click="Close_OnClick" Background="Transparent" BorderThickness="0" Foreground="#AEB9D1" FontSize="18" Content="×" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="276" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#5E10172A" BorderBrush="#18FFFFFF" BorderThickness="0,1,1,0">
                    <Grid Margin="28,30,24,26">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Width="50" Height="50" HorizontalAlignment="Left" CornerRadius="15" Background="{StaticResource Accent}" Effect="{StaticResource Glow}">
                            <Viewbox Margin="12"><Path Data="M4,2 L20,2 C21.1,2 22,2.9 22,4 L22,20 C22,21.1 21.1,22 20,22 L4,22 C2.9,22 2,21.1 2,20 L2,4 C2,2.9 2.9,2 4,2 M7,8 L17,8 M7,12 L17,12 M7,16 L13,16" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox>
                        </Border>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Steps}" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="StepMarker" Width="24" Height="24" CornerRadius="12" Background="#10FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                            <TextBlock x:Name="StepNumber" Text="{Binding Marker}" Foreground="#71809E" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="StepTitle" Grid.Column="1" Text="{Binding Title}" Foreground="#71809E" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallerStepState.Current}"><Setter TargetName="StepMarker" Property="Background" Value="#244F82FF" /><Setter TargetName="StepMarker" Property="BorderBrush" Value="#6D7EA4FF" /><Setter TargetName="StepNumber" Property="Foreground" Value="#9DB7FF" /><Setter TargetName="StepTitle" Property="Foreground" Value="#F2F5FF" /><Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallerStepState.Completed}"><Setter TargetName="StepMarker" Property="Background" Value="#1B41D6A3" /><Setter TargetName="StepMarker" Property="BorderBrush" Value="#4A41D6A3" /><Setter TargetName="StepNumber" Property="Foreground" Value="#5FE1B2" /><Setter TargetName="StepTitle" Property="Foreground" Value="#8FA1C1" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="3" Text="{Binding Version, StringFormat=版本 {0}}" Foreground="#6F7C99" FontSize="11" Margin="2,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="34,28">
                    <Grid Visibility="{Binding IsSetupPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="安装前检查" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="确认系统满足要求，然后选择安装位置。" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Requirements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RequirementCard" Background="{StaticResource Card}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="15,10">
                                                <Grid Height="38">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border x:Name="StateCircle" Width="28" Height="28" CornerRadius="14" Background="#1C41D6A3" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="StateGlyph" Text="{Binding Glyph}" Foreground="#41D6A3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" /></StackPanel>
                                                    <TextBlock x:Name="StateText" Grid.Column="2" Text="通过" Foreground="#41D6A3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static local:RequirementLevel.Notice}"><Setter TargetName="RequirementCard" Property="BorderBrush" Value="#38FFBF5B" /><Setter TargetName="StateCircle" Property="Background" Value="#20FFBF5B" /><Setter TargetName="StateGlyph" Property="Foreground" Value="#FFBF5B" /><Setter TargetName="StateText" Property="Foreground" Value="#FFBF5B" /><Setter TargetName="StateText" Property="Text" Value="安装时确认" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static local:RequirementLevel.Failed}"><Setter TargetName="RequirementCard" Property="BorderBrush" Value="#5CFF6B7A" /><Setter TargetName="StateCircle" Property="Background" Value="#20FF6B7A" /><Setter TargetName="StateGlyph" Property="Foreground" Value="#FF6B7A" /><Setter TargetName="StateText" Property="Foreground" Value="#FF6B7A" /><Setter TargetName="StateText" Property="Text" Value="未通过" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Margin="0,10,0,0" Padding="14,11" CornerRadius="10" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#1641D6A3" /><Setter Property="BorderBrush" Value="#3441D6A3" /><Style.Triggers><DataTrigger Binding="{Binding RequirementsPassed}" Value="False"><Setter Property="Background" Value="#18FF6B7A" /><Setter Property="BorderBrush" Value="#48FF6B7A" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#78E8C2" /><Style.Triggers><DataTrigger Binding="{Binding RequirementsPassed}" Value="False"><Setter Property="Foreground" Value="#FFABB3" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                                <StackPanel Margin="0,18,0,0">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="安装范围" FontWeight="SemiBold" Margin="0,0,0,9" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions><RadioButton Style="{StaticResource ScopeRadio}" IsChecked="{Binding InstallForCurrentUser}" Content="仅为当前用户安装" /><RadioButton Grid.Column="2" Style="{StaticResource ScopeRadio}" IsChecked="{Binding InstallForAllUsers}" Content="为所有用户安装" /></Grid>
                                    <TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,15,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                        <Border Background="#B00E1528" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="9" Padding="12,0"><TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#EEF2FF" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" Height="42" /></Border>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" MinWidth="92" Height="42" Content="浏览" />
                                    </Grid>
                                </StackPanel>
                                <Border Margin="0,18,0,0" Padding="18" CornerRadius="12" Background="{StaticResource Card}" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel><TextBlock Text="已安装" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="可以修复现有文件，或安全卸载应用。账号和日志数据不会由修复操作删除。" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="修复" Command="{Binding RepairCommand}" Margin="0,0,10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="卸载" Command="{Binding UninstallCommand}" Margin="0,0,10,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Command="{Binding InstallCommand}" Content="{Binding ProductAction, StringFormat={}{0}应用}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsProgressPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="34,0">
                            <TextBlock Text="正在完成设置" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="请保持此窗口打开，应用文件正在安全写入。" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,9,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressLabel}" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,42,0,18" Foreground="#8AA9FF" />
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="10" Foreground="#6088FF" Background="#18FFFFFF" BorderThickness="0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="#C7D0E5" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Background="#18FF6B7A" BorderBrush="#48FF6B7A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,18,0,0"><TextBlock Text="{Binding ErrorText}" Foreground="#FFABB3" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Button Content="停止并回滚" Command="{Binding CancelCommand}" HorizontalAlignment="Right">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding CancelConfirmationVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Border Visibility="{Binding CancelConfirmationVisible, Converter={StaticResource BoolToVisibility}}" Background="#18FFBF5B" BorderBrush="#58FFBF5B" BorderThickness="1" CornerRadius="12" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="要停止当前操作吗？" FontWeight="SemiBold" Foreground="#FFE0A0" /><TextBlock Text="已完成的步骤将由 Windows Installer 回滚。" Foreground="#D5DCEE" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="继续安装" Command="{Binding ContinueCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" Content="确认停止" Command="{Binding ConfirmCancelCommand}" /></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsResultPage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                            <Border Width="76" Height="76" CornerRadius="38" BorderThickness="1">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#2041D6A3" /><Setter Property="BorderBrush" Value="#5041D6A3" /><Style.Triggers><DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Background" Value="#20FF6B7A" /><Setter Property="BorderBrush" Value="#50FF6B7A" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✓" /><Setter Property="Foreground" Value="#41D6A3" /><Style.Triggers><DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Text" Value="!" /><Setter Property="Foreground" Value="#FF6B7A" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                            <TextBlock Text="{Binding ResultTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                            <TextBlock Text="{Binding ResultDetail}" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <CheckBox Style="{StaticResource OptionCheck}" Content="完成后打开贴吧清理助手" IsChecked="{Binding LaunchAfterFinish}" Visibility="{Binding CanLaunchAfterFinish, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Margin="0,26,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
