{
  "name": "tieba-cleaner",
  "version": "2.1.9",
  "description": "可查询、预览并选择性清理贴吧内容的 Windows 桌面工具",
  "main": "./out/main/index.js",
  "author": "TiebaCleaner Maintainers",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "prebuild": "npm run icons",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:installer": "dotnet test installer/bundle/TiebaCleaner.Bootstrapper.Tests/TiebaCleaner.Bootstrapper.Tests.csproj --configuration Release --nologo",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:installer",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:msi:internal": "npm run build && electron-builder --win msi --x64 --publish never",
    "build:msi": "npm run build:msi:internal && node scripts/write-checksum.mjs .msi",
    "build:setup": "npm run build:msi:internal && powershell -NoProfile -ExecutionPolicy Bypass -File installer/bundle/build-setup.ps1",
    "build:win": "npm run build:setup",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^6.6.3",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.44.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0"
  }
}
